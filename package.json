{
  "name": "sector-7-bodycam-ops",
  "version": "1.0.0",
  "private": true,
  "description": "SECTOR-7 // BODYCAM OPS \u2014 a procedural, fully offline WebGL tactical FPS for the browser.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://amirui123.github.io/NOTIF/",
  "repository": {
    "type": "git",
    "url": "https://github.com/amirui123/NOTIF.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "serve": "node scripts/serve.js",
    "lint": "eslint src scripts test --max-warnings 0",
    "lint:fix": "eslint src scripts test --fix",
    "format": "prettier --write \"**/*.{js,css,html,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,md,json}\"",
    "test": "npm run build:test-three && node --import ./test/helpers/setup.js --test 'test/unit/*.test.js' 'test/integration/*.test.js' 'test/scripts/*.test.js'",
    "build:test-three": "node scripts/patch-three-for-tests.js",
    "test:smoke": "npm run build:test-three && node --import ./test/helpers/setup.js --test test/integration/game.smoke.test.js",
    "check": "npm run lint && npm run test",
    "vendor:three": "node scripts/vendor-three.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "three": "0.170.0"
  }
}
