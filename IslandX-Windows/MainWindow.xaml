<Window x:Class="IslandX.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IslandX experimental" Width="320" Height="64" MinWidth="320"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
  <Border Background="{StaticResource IslandSurface}" CornerRadius="20" BorderBrush="#25252A" BorderThickness="1" Padding="14,9">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="Clock" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F6"/>
          <TextBlock x:Name="Power" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#A7F3D0"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="ExpandButton" Content="⋯" Width="28" Height="28" Margin="4,0" Click="TogglePanel" ToolTip="Open settings"/>
        <Button Grid.Column="2" Content="×" Width="28" Height="28" Click="HideToTray" ToolTip="Hide to tray"/>
      </Grid>
      <StackPanel x:Name="Panel" Visibility="Collapsed" Margin="0,10,0,0">
        <TextBlock Foreground="#9C9CA6" TextWrapping="Wrap" FontSize="11" Text="Experimental native preview: notifications and trained models are not connected yet."/>
        <CheckBox x:Name="Startup" Margin="0,10,0,0" Foreground="#F4F4F6" Content="Start at sign-in" Click="StartupChanged"/>
        <Button Margin="0,10,0,0" Content="Read clipboard now" Click="ReadClipboard" ToolTip="Read text once; nothing is stored"/>
        <TextBlock x:Name="ClipboardText" Margin="0,5,0,0" Foreground="#9C9CA6" FontSize="11" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
        <Button Margin="0,8,0,0" Content="Clear displayed clipboard text" Click="ClearClipboard"/>
        <TextBlock x:Name="Status" Margin="0,8,0,0" Foreground="#FBBF24" FontSize="10" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
