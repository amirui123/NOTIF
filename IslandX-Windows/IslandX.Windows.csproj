<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>IslandX.Windows</AssemblyName>
    <RootNamespace>IslandX.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3800.47" />
    <EmbeddedResource Include="../IslandX-Prototype/index.html" LogicalName="IslandX.Prototype.index.html" />
    <EmbeddedResource Include="native-overlay.js" LogicalName="IslandX.NativeOverlay.js" />
  </ItemGroup>
</Project>
